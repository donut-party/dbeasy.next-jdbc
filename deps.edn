{:paths ["src"]
 :deps  {com.github.seancorfield/honeysql  {:mvn/version "2.1.818"}
         com.github.seancorfield/next.jdbc {:mvn/version "1.2.737"}
         org.clojure/clojure               {:mvn/version "1.10.3"}}

 :aliases
 {:dev
  {:extra-deps  {org.xerial/sqlite-jdbc {:mvn/version "3.36.0.3"}}
   :extra-paths ["dev" "test"]}

  :test
  {:extra-paths ["test"]
   :extra-deps  {io.github.cognitect-labs/test-runner {:git/tag "v0.5.0" :git/sha "48c3c67"}
                 org.xerial/sqlite-jdbc {:mvn/version "3.36.0.3"}}
   :exec-fn     cognitect.test-runner.api/test}

  :build
  {:deps       {io.github.clojure/tools.build {:mvn/version "0.9.6"}
                slipset/deps-deploy           {:mvn/version "0.2.1"}}
   :ns-default build}}}
